---
import Base from '@/layouts/Base.astro';
import Hero from '@/sections/Hero.astro';
import Chapters from '@/sections/Chapters.astro';
import WorkShowcase from '@/sections/WorkShowcase.astro';
import FoundersPreview from '@/sections/FoundersPreview.astro';
import ConciergeTeaser from '@/sections/ConciergeTeaser.astro';
import PressStrip from '@/sections/PressStrip.astro';
import FinalCta from '@/sections/FinalCta.astro';
import { getContent } from '@/lib/content';

const content = await getContent();
---

<Base>
  <Hero lede={content.hero.lede} />
  <Chapters />
  <WorkShowcase projects={content.projects} />
  <FoundersPreview />
  <ConciergeTeaser />
  <PressStrip items={content.press} />
  <FinalCta title={content.cta.title} accent={content.cta.accent} copy={content.cta.copy} />
</Base>
