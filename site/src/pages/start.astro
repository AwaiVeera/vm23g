---
import Base from '@/layouts/Base.astro';
import { pillars } from '@/content/site';

const sent = Astro.url.searchParams.get('sent') === '1';
const preset = Astro.url.searchParams.get('need');
const stages = ['Just an idea', 'Getting ready to launch', 'Growing', 'Established'];
const timelines = ['As soon as possible', '1–3 months', '3–6 months', 'Flexible'];
const budgets = ['Under S$5k', 'S$5k–10k', 'S$10k–25k', 'S$25k+', 'Not sure yet'];
---

<Base title="Start a Project" description="Tell VM23G what you are building. A guided two-minute brief — type it or leave a voice note — that goes straight to the founders.">
  <section class="start" aria-labelledby="start-title">
    <div class="start-bg" aria-hidden="true"></div>
    <div class="wrap start-grid">
      <aside class="start-side">
        <p class="eyebrow">Start a project</p>
        <h1 id="start-title" class="display start-title">Tell us what<br /><span class="gilded">you're building.</span></h1>
        <p class="start-lede">Four short steps, about two minutes. Type it or leave a voice note — your brief goes straight to the founders.</p>
        <ol class="start-steps" aria-label="Progress">
          <li data-step-dot="1" aria-current="step"><span>01</span> What you need</li>
          <li data-step-dot="2"><span>02</span> About you</li>
          <li data-step-dot="3"><span>03</span> Scope</li>
          <li data-step-dot="4"><span>04</span> Your brief</li>
        </ol>
        <div class="start-progress" aria-hidden="true"><span data-progress></span></div>
        <button type="button" class="start-ask" data-concierge-open>Not sure yet? Ask V first →</button>
      </aside>

      <div class="start-main glass">
        {
          sent ? (
            <div class="done" tabindex="-1" data-done-static>
              <p class="eyebrow">Brief received</p>
              <h2 class="display done-title">Thank you.</h2>
              <p>Your brief is with the founders. They'll reply by email.</p>
              <a class="btn btn-gold" href="/">Back to home</a>
            </div>
          ) : (
            <form class="brief" action="/api/enquiries" method="post" enctype="multipart/form-data" novalidate data-brief>
              <input type="hidden" name="source" value="start" />
              <input type="hidden" name="started_at" value="" data-started />
              <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

              <fieldset class="step" data-step="1">
                <legend class="step-title display">What do you need?</legend>
                <p class="step-hint">Choose one or more.</p>
                <div class="pillar-grid">
                  {pillars.map((p) => (
                    <label class="pillar-opt" data-glow>
                      <input type="checkbox" name="pillars" value={p.title} checked={preset === p.key} />
                      <span class="opt-card">
                        <span class="opt-index">{p.index}</span>
                        <span class="opt-title display">{p.title}</span>
                        <span class="opt-arm">{p.arm}</span>
                        <span class="opt-desc">{p.offers.join(' · ')}</span>
                        <span class="opt-check" aria-hidden="true">
                          <svg width="14" height="14" viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </span>
                      </span>
                    </label>
                  ))}
                </div>
                <p class="field-error" data-error="pillars" role="alert"></p>
              </fieldset>

              <fieldset class="step" data-step="2">
                <legend class="step-title display">About you</legend>
                <div class="fields">
                  <label class="field">
                    <span>Your name <em aria-hidden="true">*</em></span>
                    <input name="name" autocomplete="name" required maxlength="120" />
                    <small class="field-error" data-error="name"></small>
                  </label>
                  <label class="field">
                    <span>Email <em aria-hidden="true">*</em></span>
                    <input name="email" type="email" autocomplete="email" inputmode="email" required maxlength="200" />
                    <small class="field-error" data-error="email"></small>
                  </label>
                  <label class="field">
                    <span>Company or brand <small>(optional)</small></span>
                    <input name="company" autocomplete="organization" maxlength="160" />
                  </label>
                  <label class="field">
                    <span>Phone or WhatsApp <small>(optional)</small></span>
                    <input name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" />
                  </label>
                </div>
              </fieldset>

              <fieldset class="step" data-step="3">
                <legend class="step-title display">Scope</legend>
                <div class="choice-group">
                  <p class="choice-label" id="stage-label">Where are you today?</p>
                  <div class="chips" role="radiogroup" aria-labelledby="stage-label">
                    {stages.map((s) => (
                      <label class="chip"><input type="radio" name="stage" value={s} /><span>{s}</span></label>
                    ))}
                  </div>
                </div>
                <div class="choice-group">
                  <p class="choice-label" id="timeline-label">Ideal timeline</p>
                  <div class="chips" role="radiogroup" aria-labelledby="timeline-label">
                    {timelines.map((s) => (
                      <label class="chip"><input type="radio" name="timeline" value={s} /><span>{s}</span></label>
                    ))}
                  </div>
                </div>
                <div class="choice-group">
                  <p class="choice-label" id="budget-label">Budget range</p>
                  <div class="chips" role="radiogroup" aria-labelledby="budget-label">
                    {budgets.map((s) => (
                      <label class="chip"><input type="radio" name="budget" value={s} checked={s === 'Not sure yet'} /><span>{s}</span></label>
                    ))}
                  </div>
                </div>
              </fieldset>

              <fieldset class="step" data-step="4">
                <legend class="step-title display">Your brief</legend>
                <label class="field">
                  <span>Tell us about the project</span>
                  <textarea name="message" rows="5" maxlength="4000" placeholder="What are you building, who is it for, and what would success look like?"></textarea>
                  <small class="field-error" data-error="message"></small>
                </label>

                <div class="voice" data-voice hidden>
                  <div class="voice-head">
                    <p class="choice-label">Or leave a voice note <small>(up to 3 minutes)</small></p>
                  </div>
                  <div class="voice-row">
                    <button type="button" class="voice-btn" data-rec aria-pressed="false">
                      <span class="voice-dot" aria-hidden="true"></span>
                      <span data-rec-label>Record</span>
                    </button>
                    <canvas class="voice-wave" width="320" height="48" data-wave aria-hidden="true"></canvas>
                    <span class="voice-time" data-rec-time aria-live="polite">0:00</span>
                  </div>
                  <div class="voice-review" data-rec-review hidden>
                    <audio controls data-rec-audio></audio>
                    <button type="button" class="link-btn" data-rec-discard>Remove voice note</button>
                  </div>
                  <small class="field-error" data-error="voice"></small>
                </div>

                <label class="consent">
                  <input type="checkbox" name="consent" value="yes" required />
                  <span>VM23G may contact me about this enquiry. I have read the <a href="/legal#privacy">privacy notice</a>.</span>
                </label>
                <small class="field-error" data-error="consent"></small>
              </fieldset>

              <p class="form-error" data-form-error role="alert"></p>

              <div class="brief-actions">
                <button type="button" class="btn btn-ghost" data-prev hidden>Back</button>
                <button type="button" class="btn btn-gold" data-next>Continue</button>
                <button type="submit" class="btn btn-gold" data-submit hidden>Send brief</button>
              </div>
            </form>
          )
        }

        <div class="done" data-done hidden tabindex="-1">
          <div class="done-mark" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </div>
          <p class="eyebrow">Brief received</p>
          <h2 class="display done-title">Thank you, <span data-done-name></span>.</h2>
          <p class="done-copy">Your brief is with the founders. They'll reply to <strong data-done-email></strong>.</p>
          <div class="done-actions">
            <a class="btn btn-gold" href="/work">Explore our work</a>
            <button type="button" class="btn btn-ghost" data-concierge-open>Ask V meanwhile</button>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .start {
    position: relative;
    min-height: 100svh;
    padding: calc(var(--nav-h) + 3rem) 0 var(--space-7);
  }

  .start-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(50% 50% at 15% 25%, rgb(var(--olive-rgb) / 0.25), transparent 70%),
      radial-gradient(40% 40% at 90% 80%, rgb(var(--gold-rgb) / 0.08), transparent 70%);
  }

  .start-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .start-side {
    position: sticky;
    top: calc(var(--nav-h) + 3rem);
    display: grid;
    gap: var(--space-4);
  }

  .start-title {
    font-size: var(--step-4);
    line-height: 1.05;
  }

  .start-lede {
    color: var(--text-2);
  }

  .start-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .start-steps li {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    color: var(--text-3);
    font-weight: 600;
    font-size: 0.95rem;
    transition: color var(--dur-2) var(--ease-cine);
  }

  .start-steps li span {
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    color: var(--text-3);
  }

  .start-steps li[aria-current='step'],
  .start-steps li[data-done-step] {
    color: var(--text);
  }

  .start-steps li[aria-current='step'] span,
  .start-steps li[data-done-step] span {
    color: var(--gold);
  }

  .start-progress {
    height: 2px;
    border-radius: 2px;
    background: rgb(242 237 223 / 0.08);
    overflow: hidden;
  }

  .start-progress span {
    display: block;
    height: 100%;
    width: 25%;
    background: linear-gradient(90deg, var(--gold), var(--gold-hi));
    box-shadow: 0 0 12px var(--gold);
    transition: width var(--dur-3) var(--ease-cine);
  }

  .start-ask {
    justify-self: start;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--gold-hi);
    font-weight: 650;
    cursor: pointer;
  }

  .start-ask:hover,
  .start-ask:focus-visible {
    text-shadow: 0 0 18px rgb(var(--gold-rgb) / 0.6);
  }

  .start-main {
    padding: clamp(1.25rem, 3.5vw, 3rem);
    min-height: 520px;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .step {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
    display: grid;
    gap: var(--space-4);
  }

  :global(.js-steps) .step:not(.is-active) {
    display: none;
  }

  .step.is-active {
    animation: step-in 560ms var(--ease-cine) both;
  }

  @keyframes step-in {
    from {
      opacity: 0;
      transform: translate3d(18px, 0, 0);
    }
  }

  :global(html:not(.js-steps)) .step + .step {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line-soft);
  }

  .step-title {
    padding: 0;
    font-size: var(--step-3);
  }

  .step-hint {
    margin-top: -0.75rem;
    color: var(--text-2);
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .pillar-opt {
    --mx: 50%;
    --my: 50%;
    position: relative;
    cursor: pointer;
  }

  .pillar-opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .opt-card {
    position: relative;
    display: grid;
    gap: 0.3rem;
    height: 100%;
    padding: 1.1rem 1.2rem 1.2rem;
    border-radius: var(--radius-m);
    border: 1px solid var(--line-soft);
    background:
      radial-gradient(260px circle at var(--mx) var(--my), rgb(var(--gold-rgb) / 0.1), transparent 60%),
      rgb(5 8 6 / 0.45);
    transition: border-color var(--dur-2) var(--ease-cine), box-shadow var(--dur-2) var(--ease-cine), transform var(--dur-2) var(--ease-cine);
  }

  .pillar-opt:hover .opt-card {
    border-color: rgb(var(--gold-rgb) / 0.4);
    transform: translateY(-2px);
  }

  .pillar-opt input:focus-visible + .opt-card {
    outline: 2px solid var(--gold-hi);
    outline-offset: 3px;
  }

  .pillar-opt input:checked + .opt-card {
    border-color: rgb(var(--gold-rgb) / 0.8);
    box-shadow: 0 0 0 1px rgb(var(--gold-rgb) / 0.5), 0 0 40px -12px rgb(var(--gold-rgb) / 0.6);
    background:
      radial-gradient(260px circle at var(--mx) var(--my), rgb(var(--gold-rgb) / 0.16), transparent 60%),
      rgb(var(--gold-rgb) / 0.06);
  }

  .opt-index {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--gold);
  }

  .opt-title {
    font-size: 1.45rem;
  }

  .opt-arm {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .opt-desc {
    margin-top: 0.3rem;
    font-size: 0.86rem;
    color: var(--text-2);
  }

  .opt-check {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: transparent;
    transition: all var(--dur-2) var(--ease-cine);
  }

  .pillar-opt input:checked + .opt-card .opt-check {
    background: var(--gold);
    border-color: var(--gold);
    color: #1d1708;
    transform: scale(1.08);
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-2);
  }

  .field em {
    color: var(--gold);
    font-style: normal;
  }

  .field small {
    font-weight: 500;
  }

  .field input,
  .field textarea {
    min-height: 50px;
    padding: 0.75rem 1rem;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: rgb(5 8 6 / 0.55);
    color: var(--text);
    font-size: 1rem;
    font-weight: 450;
    transition: border-color var(--dur-2) var(--ease-cine), box-shadow var(--dur-2) var(--ease-cine);
  }

  .field textarea {
    resize: vertical;
    line-height: 1.55;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: rgb(var(--gold-rgb) / 0.75);
    box-shadow: 0 0 0 4px rgb(var(--gold-rgb) / 0.15);
  }

  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: #d99a5b;
  }

  .field-error,
  .form-error {
    min-height: 1em;
    font-size: 0.84rem;
    font-weight: 500;
    color: #f0b27a;
  }

  .choice-group {
    display: grid;
    gap: 0.7rem;
  }

  .choice-label {
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--text);
  }

  .choice-label small {
    color: var(--text-3);
    font-weight: 500;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    position: relative;
    cursor: pointer;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.05rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(5 8 6 / 0.45);
    font-size: 0.9rem;
    transition: all var(--dur-2) var(--ease-cine);
  }

  .chip:hover span {
    border-color: rgb(var(--gold-rgb) / 0.5);
  }

  .chip input:checked + span {
    background: rgb(var(--gold-rgb) / 0.16);
    border-color: rgb(var(--gold-rgb) / 0.8);
    color: var(--gold-hi);
    box-shadow: 0 0 24px -8px rgb(var(--gold-rgb) / 0.6);
  }

  .chip input:focus-visible + span {
    outline: 2px solid var(--gold-hi);
    outline-offset: 2px;
  }

  .voice {
    display: grid;
    gap: 0.7rem;
    padding: 1rem;
    border-radius: var(--radius-m);
    border: 1px dashed var(--line);
    background: rgb(5 8 6 / 0.35);
  }

  .voice[hidden] {
    display: none;
  }

  .voice-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .voice-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 46px;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--gold-rgb) / 0.5);
    background: rgb(var(--gold-rgb) / 0.08);
    color: var(--text);
    font-weight: 650;
    cursor: pointer;
    flex: none;
  }

  .voice-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #d9643b;
    box-shadow: 0 0 10px rgb(217 100 59 / 0.7);
  }

  .voice-btn[aria-pressed='true'] .voice-dot {
    border-radius: 3px;
    animation: rec 1.2s var(--ease-soft) infinite;
  }

  @keyframes rec {
    50% {
      opacity: 0.35;
    }
  }

  .voice-wave {
    flex: 1;
    min-width: 0;
    height: 48px;
  }

  .voice-time {
    flex: none;
    font-variant-numeric: tabular-nums;
    color: var(--text-2);
    font-size: 0.9rem;
  }

  .voice-review {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .voice-review audio {
    max-width: 100%;
    height: 40px;
  }

  .link-btn {
    min-height: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--gold-hi);
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    font-size: 0.9rem;
    color: var(--text-2);
    cursor: pointer;
  }

  .consent input {
    width: 22px;
    height: 22px;
    margin-top: 0.1rem;
    accent-color: var(--gold);
  }

  .consent a {
    color: var(--gold-hi);
  }

  .brief-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-soft);
  }

  .brief-actions [data-prev] {
    margin-right: auto;
  }

  .brief-actions [hidden] {
    display: none;
  }

  .done {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding-block: var(--space-5);
    animation: step-in 700ms var(--ease-cine) both;
  }

  .done[hidden] {
    display: none;
  }

  .done-mark {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    color: #1d1708;
    background: radial-gradient(circle at 35% 30%, rgb(255 240 200 / 0.6), transparent 40%), var(--gold);
    box-shadow: 0 0 60px -10px rgb(var(--gold-rgb) / 0.8);
    animation: done-pop 900ms var(--ease-cine) both;
  }

  @keyframes done-pop {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }

  .done-title {
    font-size: var(--step-4);
  }

  .done-copy {
    color: var(--text-2);
    max-width: 48ch;
  }

  .done-copy strong {
    color: var(--text);
  }

  .done-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-2);
  }

  @media (max-width: 960px) {
    .start-grid {
      grid-template-columns: 1fr;
    }

    .start-side {
      position: static;
    }

    .start-steps,
    .start-ask {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .start {
      padding-top: calc(var(--nav-h) + 1.5rem);
      padding-bottom: 7rem;
    }

    .pillar-grid,
    .fields {
      grid-template-columns: 1fr;
    }

    .start-main {
      padding: 1.1rem;
      border-radius: var(--radius-m);
    }

    .brief-actions {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      margin: 0;
      padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
      background: rgb(8 13 9 / 0.92);
      border-top: 1px solid var(--line);
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
    }

    .brief-actions .btn {
      flex: 1;
    }

    .brief-actions [data-prev] {
      flex: 0 0 auto;
    }
  }
</style>

<script>
  import '@/systems/glow';
  import { mountBrief } from '@/systems/brief';
  mountBrief();
</script>
