---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { legalPageContent as legal } from '@/content/pages';
import { startHref } from '@/content/site';

const entity = legal.legalEntity;

const policies = [
  { key: 'payment-terms', title: 'Payment Terms', body: [entity.paymentTerms] },
  { key: 'refund-policy', title: 'Refunds & Cancellations', body: [entity.refundPolicy] },
  { key: 'coaching-disclaimer', title: 'Coaching & Wellness Disclaimer', body: [entity.coachingDisclaimer] },
  { key: 'ai-disclaimer', title: 'AI Services Disclaimer', body: [entity.aiServicesDisclaimer] },
  { key: 'data-retention', title: 'Data Retention', body: [entity.dataRetentionPeriod] },
  { key: 'processors', title: 'Third-Party Processors', body: [entity.thirdPartyProcessors] },
  { key: 'analytics', title: 'Analytics', body: [entity.analyticsTools] },
  { key: 'marketing', title: 'Marketing', body: [entity.marketingTools] },
  { key: 'cookie-tools', title: 'Cookies & Consent Tools', body: [entity.cookieTools] },
];

const sections = [
  ...legal.sections
    .filter((s) => s.key !== 'contact')
    .map((s) => ({ key: s.key, title: s.title, body: s.body.filter((line) => !line.includes('TBD')) })),
  ...policies,
];

const updated = legal.lastUpdated;
---

<Base
  title="Legal & Privacy"
  description="Terms, privacy, cookies, disclaimers and policies for the VM23G website, operated by VM23 Group in Singapore."
>
  <PageHero eyebrow="Legal hub" title="Legal &" accent="privacy." copy={`Policies for the VM23G website and services. Last updated ${updated}.`} />

  <section class="section legal" aria-label="Legal content">
    <div class="wrap legal-grid">
      <nav class="toc" aria-label="On this page">
        <p class="toc-head">On this page</p>
        <ol>
          <li><a href="#entity">Who we are</a></li>
          {sections.map((s) => <li><a href={`#${s.key}`}>{s.title}</a></li>)}
          <li><a href="#contact">Contact</a></li>
        </ol>
      </nav>

      <div class="legal-body">
        <aside class="notice glass" role="note">
          <p class="notice-head">Template notice</p>
          <p>{legal.templateNotice}</p>
        </aside>

        <article id="entity" class="legal-section">
          <h2 class="display">Who we are</h2>
          <dl class="entity">
            <div><dt>Legal entity</dt><dd>{entity.legalEntityName}</dd></div>
            <div><dt>Trading names</dt><dd>{entity.tradingName}</dd></div>
            <div><dt>Governing law</dt><dd>{entity.governingLaw}</dd></div>
          </dl>
        </article>

        {
          sections.map((s) => (
            <article id={s.key} class="legal-section">
              <h2 class="display">{s.title}</h2>
              {s.body.length > 1 ? (
                <ul>
                  {s.body.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              ) : (
                s.body.map((line) => <p>{line}</p>)
              )}
            </article>
          ))
        }

        <article id="contact" class="legal-section">
          <h2 class="display">Contact / Data Protection Contact</h2>
          <p>
            For general enquiries, data access or correction requests, or data protection questions, contact us through the{' '}
            <a href={startHref}>Start a Project form</a>. Please mention "Data protection" in your message for privacy requests.
          </p>
        </article>

        <article class="legal-section legal-sources">
          <h2 class="display">Singapore references</h2>
          <ul>
            {legal.singaporeSources.map((s) => <li>{s}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .legal {
    padding-top: var(--space-5);
  }

  .legal-grid {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .toc {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
    max-height: calc(100dvh - var(--nav-h) - 4rem);
    overflow-y: auto;
    padding: 1.2rem;
    border-radius: var(--radius-m);
    border: 1px solid var(--line-soft);
    background: rgb(var(--glass-rgb) / 0.5);
  }

  .toc-head {
    margin-bottom: 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .toc a {
    display: block;
    padding: 0.35rem 0.5rem;
    border-radius: 8px;
    font-size: 0.88rem;
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--dur-1) ease, background-color var(--dur-1) ease;
  }

  .toc a:hover,
  .toc a:focus-visible {
    color: var(--text);
    background: rgb(var(--gold-rgb) / 0.07);
  }

  .legal-body {
    display: grid;
    gap: var(--space-6);
    max-width: 72ch;
  }

  .notice {
    padding: 1.3rem 1.5rem;
    border-radius: var(--radius-m);
  }

  .notice-head {
    margin-bottom: 0.3rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .notice p:last-child {
    color: var(--text-2);
  }

  .legal-section {
    display: grid;
    gap: 0.9rem;
    scroll-margin-top: calc(var(--nav-h) + 2rem);
  }

  .legal-section h2 {
    font-size: var(--step-2);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .legal-section p,
  .legal-section li {
    color: var(--text-2);
    line-height: 1.75;
  }

  .legal-section ul {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.5rem;
  }

  .legal-section li::marker {
    color: var(--gold);
  }

  .legal-section a {
    color: var(--gold-hi);
  }

  .entity {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .entity div {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1rem;
  }

  .entity dt {
    color: var(--text-3);
    font-size: 0.9rem;
  }

  .entity dd {
    margin: 0;
  }

  @media (max-width: 900px) {
    .legal-grid {
      grid-template-columns: 1fr;
    }

    .toc {
      position: static;
      max-height: none;
    }
  }

  @media (max-width: 480px) {
    .entity div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
