---
import Picture from '@/components/Picture.astro';
import { startHref } from '@/content/site';

interface Props {
  lede?: string;
}

const {
  lede = 'A Singapore group building AI systems, websites and apps, brands and media — and the discipline of body and mind behind them.',
} = Astro.props;

const line = ['Mind.', 'Body.', 'Brand.', 'Technology.'];
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-bg" aria-hidden="true">
    <canvas class="hero-canvas" data-halo></canvas>
    <div class="hero-vignette"></div>
  </div>

  <div class="hero-inner wrap">
    <div class="monument" data-stage>
      <div class="orbit" data-tilt aria-hidden="true">
        <span class="ring ring-outer" data-depth="0.5"></span>
        <span class="ring ring-inner" data-depth="1"></span>
        <span class="disc" data-depth="0.25"></span>
      </div>
      <div class="emblem">
        <span class="emblem-glow" aria-hidden="true"></span>
        <Picture
          src="brand/vm23g-logo"
          alt="VM23G — VM 23 Group logo: a gold bull with circuit traces"
          sizes="(max-width: 720px) 70vw, 460px"
          loading="eager"
          fetchpriority="high"
          imgClass="emblem-img"
        />
        <span class="emblem-sheen" aria-hidden="true"></span>
      </div>
    </div>

    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title display">
        {line.map((w, i) => <span class="word" style={`--i:${i}`}>{w}</span>)}
      </h1>
      <p class="hero-lede">{lede}</p>
      <div class="hero-ctas">
        <a class="btn btn-gold" href={startHref}>
          Start a Project
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
        <a class="btn btn-ghost" href="/work">Explore Our Work</a>
      </div>
    </div>
  </div>

  <div class="hero-foot wrap">
    <button type="button" class="hero-motion" data-motion-toggle aria-pressed="false">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect x="3" y="2.5" width="2.4" height="9" rx="1" fill="currentColor"></rect><rect x="8.6" y="2.5" width="2.4" height="9" rx="1" fill="currentColor"></rect></svg>
      <span data-motion-label>Pause motion</span>
    </button>
    <a class="scroll-cue" href="#chapters" aria-label="Scroll to explore">
      <span class="cue-line" aria-hidden="true"></span>
    </a>
    <span class="foot-spacer" aria-hidden="true"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-top: calc(var(--nav-h) + clamp(0.5rem, 2vh, 1.5rem));
    overflow: clip;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(38% 42% at 50% 36%, rgb(var(--gold-rgb) / 0.12), transparent 70%),
      radial-gradient(70% 60% at 50% 38%, rgb(var(--olive-rgb) / 0.3), transparent 74%),
      var(--canvas);
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.6s var(--ease-soft);
  }

  .hero-canvas:global(.is-ready) {
    opacity: 1;
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 55%, var(--canvas) 100%),
      radial-gradient(120% 90% at 50% 40%, transparent 55%, rgb(0 0 0 / 0.55) 100%);
  }

  .hero-inner {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: clamp(1.25rem, 3.5vh, 2.5rem);
    text-align: center;
    padding-block: clamp(0.5rem, 2vh, 1.5rem);
  }

  .monument {
    --size: min(420px, 66vw, 38svh);
    position: relative;
    display: grid;
    place-items: center;
    width: calc(var(--size) * 1.25);
    max-width: 100%;
    aspect-ratio: 1;
    perspective: 1200px;
  }

  .orbit {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transform-style: preserve-3d;
    transform: rotateX(calc(var(--ty, 0) * 1deg)) rotateY(calc(var(--tx, 0) * 1deg));
    transition: transform 1s var(--ease-cine);
    pointer-events: none;
  }

  .ring,
  .disc {
    position: absolute;
    border-radius: 50%;
    translate: calc(var(--px, 0) * 1px) calc(var(--py, 0) * 1px);
    transition: translate 1.1s var(--ease-cine);
  }

  .ring-outer {
    height: 98%;
    aspect-ratio: 1;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      rgb(var(--gold-rgb) / 0.55) 50deg,
      transparent 120deg,
      rgb(var(--olive-rgb) / 0.6) 210deg,
      transparent 300deg
    );
    -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 2px), #000 calc(100% - 1px), transparent 100%);
    mask: radial-gradient(closest-side, transparent calc(100% - 2px), #000 calc(100% - 1px), transparent 100%);
    animation: spin 46s linear infinite;
  }

  .ring-inner {
    height: 88%;
    aspect-ratio: 1;
    border: 1px solid rgb(var(--gold-rgb) / 0.16);
    box-shadow:
      inset 0 0 40px rgb(var(--olive-rgb) / 0.25),
      0 0 60px -20px rgb(var(--gold-rgb) / 0.35);
  }

  .disc {
    height: 80%;
    aspect-ratio: 1;
    background:
      radial-gradient(closest-side, rgb(var(--gold-rgb) / 0.1), transparent 75%),
      linear-gradient(155deg, rgb(242 237 223 / 0.07), rgb(242 237 223 / 0.01) 40%, rgb(0 0 0 / 0.2));
    border: 1px solid rgb(var(--gold-rgb) / 0.12);
    -webkit-backdrop-filter: blur(10px) saturate(125%);
    backdrop-filter: blur(10px) saturate(125%);
    box-shadow:
      inset 0 1px 0 rgb(var(--gold-rgb) / 0.25),
      0 40px 80px -30px rgb(0 0 0 / 0.8);
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  .emblem {
    position: relative;
    width: var(--size);
    max-width: 70%;
    aspect-ratio: 1306 / 1019;
    animation: rise 1.4s var(--ease-cine) both;
  }

  .emblem-glow {
    position: absolute;
    inset: 12% 18%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(var(--gold-rgb) / 0.32), transparent);
    filter: blur(28px);
    animation: breathe 7s var(--ease-soft) infinite;
  }

  .emblem :global(picture) {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }

  .emblem :global(.emblem-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .emblem-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 40%, rgb(255 246 220 / 0.55) 50%, transparent 60%);
    background-size: 300% 100%;
    background-position: 150% 0;
    -webkit-mask: url('/media/brand/vm23g-logo-1280.avif') center / contain no-repeat;
    mask: url('/media/brand/vm23g-logo-1280.avif') center / contain no-repeat;
    mix-blend-mode: soft-light;
    animation: sheen 9s var(--ease-soft) infinite 1.8s;
    pointer-events: none;
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes sheen {
    0% {
      background-position: 150% 0;
    }
    45%,
    100% {
      background-position: -50% 0;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .hero-copy {
    display: grid;
    justify-items: center;
    gap: clamp(0.9rem, 2vh, 1.4rem);
    max-width: 62rem;
  }

  .hero-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.45em;
    row-gap: 0.1em;
    margin: 0;
    font-size: clamp(1.7rem, 0.9rem + 3.2vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: 0.06em;
  }

  .word {
    background: linear-gradient(180deg, var(--gold-hi) 0%, var(--gold) 70%, #a8863f 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: word-in 1.1s var(--ease-cine) both;
    animation-delay: calc(300ms + var(--i) * 120ms);
  }

  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(0.4em);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  .hero-lede {
    max-width: 46ch;
    margin: 0;
    color: var(--text-2);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    animation: word-in 1.1s var(--ease-cine) both 800ms;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    animation: word-in 1.1s var(--ease-cine) both 950ms;
  }

  .hero-foot {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: var(--space-2) var(--space-4);
  }

  .foot-spacer {
    min-width: 0;
  }

  .scroll-cue {
    display: grid;
    place-items: center;
    width: 44px;
    height: 52px;
  }

  .cue-line {
    position: relative;
    width: 1px;
    height: 40px;
    background: rgb(var(--gold-rgb) / 0.25);
    overflow: hidden;
  }

  .cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent, var(--gold-hi), transparent);
    animation: cue 2.4s var(--ease-soft) infinite;
  }

  @keyframes cue {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  .hero-motion {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid var(--line-soft);
    background: rgb(var(--glass-rgb) / 0.5);
    color: var(--text-2);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      color var(--dur-1) ease,
      border-color var(--dur-2) var(--ease-cine),
      box-shadow var(--dur-2) var(--ease-cine);
  }

  .hero-motion:hover,
  .hero-motion:focus-visible {
    color: var(--text);
    border-color: rgb(var(--gold-rgb) / 0.5);
    box-shadow: var(--shadow-glow);
  }

  @media (max-width: 720px) {
    .hero {
      min-height: auto;
    }

    .monument {
      --size: min(300px, 70vw);
    }

    .hero-title {
      font-size: clamp(1.45rem, 7.4vw, 2.1rem);
      letter-spacing: 0.04em;
    }

    .hero-ctas {
      width: 100%;
    }

    .hero-ctas .btn {
      flex: 1 1 12rem;
      justify-content: center;
    }

    .hero-foot {
      padding-bottom: calc(var(--space-4) + 64px);
    }

    .scroll-cue {
      display: none;
    }
  }

  @media (max-height: 640px) and (min-width: 721px) {
    .monument {
      --size: min(340px, 36svh);
    }
  }

  :global([data-motion='paused']) .hero *,
  :global([data-motion='paused']) .hero *::before,
  :global([data-motion='paused']) .hero *::after {
    animation-play-state: paused !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit {
      transform: none !important;
    }

    .ring,
    .disc {
      translate: none !important;
    }

    .ring-outer,
    .emblem-glow,
    .emblem-sheen,
    .cue-line::after {
      animation: none;
    }

    .word,
    .hero-lede,
    .hero-ctas,
    .emblem {
      animation: none;
    }
  }
</style>

<script>
  import { mountHalo } from '@/animations/halo';
  import { motionAllowed } from '@/systems/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('[data-halo]');
  const stage = hero?.querySelector<HTMLElement>('[data-stage]');
  const tilt = hero?.querySelector<HTMLElement>('[data-tilt]');
  const layers = hero?.querySelectorAll<HTMLElement>('[data-depth]') ?? [];

  const center = (): [number, number] => {
    if (!hero || !stage) return [0.5, 0.6];
    const h = hero.getBoundingClientRect();
    const s = stage.getBoundingClientRect();
    return [(s.left + s.width / 2 - h.left) / h.width, 1 - (s.top + s.height / 2 - h.top) / h.height];
  };

  if (canvas) {
    const start = () => mountHalo(canvas, center);
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 900 });
    else setTimeout(start, 200);
  }

  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  if (hero && tilt && fine.matches) {
    let raf = 0;
    const reset = () => {
      tilt.style.setProperty('--tx', '0');
      tilt.style.setProperty('--ty', '0');
      layers.forEach((l) => {
        l.style.setProperty('--px', '0');
        l.style.setProperty('--py', '0');
      });
    };
    hero.addEventListener(
      'pointermove',
      (e) => {
        if (!motionAllowed()) return;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = hero.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          tilt.style.setProperty('--tx', (x * 14).toFixed(2));
          tilt.style.setProperty('--ty', (-y * 10).toFixed(2));
          layers.forEach((l) => {
            const d = Number(l.dataset.depth);
            l.style.setProperty('--px', (x * 22 * d).toFixed(1));
            l.style.setProperty('--py', (y * 16 * d).toFixed(1));
          });
        });
      },
      { passive: true },
    );
    hero.addEventListener('pointerleave', reset);
    window.addEventListener('vm23g:motion', () => {
      if (!motionAllowed()) reset();
    });
  }
</script>
